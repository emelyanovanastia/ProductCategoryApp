@model IEnumerable<ProductCategoryApp.Models.Category>
@{
    ViewData["Title"] = "Категории";
}

<h1>Категории</h1>

<p><a asp-action="Create" class="btn btn-success">+ Добавить категорию</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Название</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Категорий пока нет.</p>
}