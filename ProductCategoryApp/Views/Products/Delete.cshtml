@model ProductCategoryApp.Models.Product
@{
    ViewData["Title"] = "Удаление товара";
}

<h1>Удалить этот товар?</h1>

<dl class="row">
    <dt class="col-sm-2">Название</dt>
    <dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Категория</dt>
    <dd class="col-sm-10">@Model.Category?.Name</dd>
    <dt class="col-sm-2">Цена</dt>
    <dd class="col-sm-10">@Model.Price.ToString("N2")</dd>
    <dt class="col-sm-2">Остаток</dt>
    <dd class="col-sm-10">@Model.Stock</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Да, удалить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>