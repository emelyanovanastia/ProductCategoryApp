@model Product
@{
    ViewData["Title"] = "Home Page";
}


 <form method="post">

        <div class="mb-3">
            <label for="mass" class="form-label">
                Название номенклатуры
            </label>
            <input type="number" class="form-control"
                   id="mass" name="mass"
                   min="0.1" step="0.1" required>
        </div>

        <div class="mb-3">
            <label for="sulfur" class="form-label">
                Цена
            </label>
            <input type="number" class="form-control"
                   id="sulfur" name="sulfur"
                   min="0" step="0.001" required>
        </div>


        <div class="mb-3">
            <label for="mass" class="form-label">
                Склад
            </label>
            <input type="number" class="form-control"
                   id="mass" name="mass"
                   min="0.1" step="0.1" required>
        </div>

        <div class="mb-3">
            <label for="sulfur" class="form-label">
                Остаток на складе, шт
            </label>
            <input type="number" class="form-control"
                   id="sulfur" name="sulfur"
                   min="0" step="0.001" required>
        </div>


        <button type="submit" class="btn btn-primary">
            Сохранить
        </button>

    </form>